# ==============================================================================
# API Parameter Coverage - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# REQUIRED: OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OPTIONAL: Environment (development, production, testing)
APP_ENV=development

# OPTIONAL: LLM Settings
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=3000
LLM_TEMPERATURE=0.7

# OPTIONAL: Algorithm Settings
CHUNK_SIZE=12
CHUNKING_THRESHOLD=15

# OPTIONAL: Paths
OUTPUT_DIR=output
SCHEMAS_DIR=schemas

# OPTIONAL: Debug
DEBUG=false
VERBOSE=false
LOG_LEVEL=INFO
